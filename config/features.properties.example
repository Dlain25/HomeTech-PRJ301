# Copy to %USERPROFILE%/.hometech/features.properties (UTF-8).
# This file is separate from DBContext / your existing database configuration.
# Leave unset features blank. Never commit real credentials to Git.

# VietQR: bank BIN/short code, account number, account holder, template.
HOMETECH_BANK_ID=
HOMETECH_BANK_ACCOUNT=
HOMETECH_BANK_NAME=
HOMETECH_QR_TEMPLATE=compact2

# Fixed application URL; change context/port to your actual deployment.
HOMETECH_APP_BASE_URL=http://localhost:9999/Group04
HOMETECH_SMTP_HOST=
HOMETECH_SMTP_PORT=587
HOMETECH_SMTP_MODE=STARTTLS
HOMETECH_SMTP_USER=
HOMETECH_SMTP_PASSWORD=
HOMETECH_MAIL_FROM=

# SSL is also supported (usually provider port 465).
# An externally accessible APP_BASE_URL must use HTTPS.
# To use another config path, set HOMETECH_FEATURE_CONFIG in Tomcat's
# environment or Java system properties. Use forward slashes in Windows paths.
