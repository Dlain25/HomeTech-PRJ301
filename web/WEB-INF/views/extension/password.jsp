<%@ page pageEncoding="UTF-8" %>
<%@ include file="tags.jspf" %><c:set var="pageTitle" value="${resetMode?'Đặt lại mật khẩu':'Quên mật khẩu'}"/><%@ include file="header.jspf" %>
<section class="ex-card ex-auth"><c:if test="${not empty error}"><p class="ex-notice error" role="alert"><c:out value="${error}"/></p></c:if><c:if test="${not empty success}"><p class="ex-notice success" role="status"><c:out value="${success}"/></p></c:if>
<c:choose><c:when test="${resetMode}"><p>Liên kết dùng một lần, có hiệu lực 15 phút. Mật khẩu mới từ 8–64 ký tự, có chữ và số.</p><c:if test="${not empty sessionScope.resetToken}"><form class="ex-form" method="post"><label>Mật khẩu mới<input type="password" name="password" minlength="8" maxlength="64" autocomplete="new-password" required></label><label>Nhập lại mật khẩu<input type="password" name="confirmPassword" minlength="8" maxlength="64" autocomplete="new-password" required></label><button>Đặt lại mật khẩu</button><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"></form></c:if><a href="${cp}/forgot-password">Gửi liên kết mới</a></c:when>
<c:otherwise><p>Nhập email bạn đã dùng để đăng ký HomeTech. Chúng tôi sẽ gửi liên kết đặt lại mật khẩu.</p><c:if test="${!mailReady}"><p class="ex-notice">Gửi email tạm chưa sẵn sàng. Vui lòng liên hệ quản trị viên để cấu hình dịch vụ email.</p></c:if><form class="ex-form" method="post"><label>Email đăng ký<input type="email" name="email" maxlength="254" autocomplete="email" required></label><button ${!mailReady?'disabled':''}>Gửi liên kết đặt lại mật khẩu</button><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"></form></c:otherwise></c:choose><p><a href="${cp}/login">← Quay lại đăng nhập</a></p></section>
<%@ include file="footer.jspf" %>
