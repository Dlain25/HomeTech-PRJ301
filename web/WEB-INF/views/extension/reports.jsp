<%@ page pageEncoding="UTF-8" %>
<%@ include file="tags.jspf" %><c:set var="pageTitle" value="Doanh thu & tiến độ đơn hàng"/><%@ include file="header.jspf" %>
<form class="ex-card ex-filter" method="get"><label>Ngày theo dõi / tháng báo cáo<input type="date" name="day" value="${day}" required></label><label>Năm thống kê<input type="number" name="year" min="2000" max="2100" value="${year}" required></label><button>Xem thống kê</button></form>
<div class="ex-metrics"><div class="ex-card"><span>Cần hoàn thành ngày ${day}</span><strong>${work.remaining}</strong></div><div class="ex-card"><span>Đã giao trong lịch ngày chọn</span><strong>${work.completed}</strong></div><div class="ex-card"><span>Quá hạn trước ngày chọn</span><strong>${overdue.total}</strong></div><div class="ex-card"><span>Chưa có lịch nhận</span><strong>${unscheduled.total}</strong></div></div>
<p>Tổng đơn hẹn ngày chọn: ${work.scheduled} · Đã hủy: ${work.cancelled} · Đơn mới tạo ngày chọn: ${created.total}</p>
<section class="ex-card"><h2>Công việc ngày ${day}</h2><c:if test="${empty tasks}"><p>Không còn đơn phải hoàn thành trong lịch ngày chọn.</p></c:if><div class="ex-table"><table><thead><tr><th>Đơn</th><th>Người nhận</th><th>Điện thoại</th><th>Khung giờ</th><th>Trạng thái</th></tr></thead><tbody><c:forEach var="r" items="${tasks}"><tr><td><a href="${cp}/admin/orders?detail=${r.order_id}">#${r.order_id}</a></td><td><c:out value="${r.recipient_name}"/></td><td><c:out value="${r.recipient_phone}"/></td><td><c:out value="${labels[r.delivery_slot]}"/></td><td><c:out value="${labels[r.order_status]}"/></td></tr></c:forEach></tbody></table></div><p class="ex-muted">Tối đa 100 đơn trong bảng. Xem danh sách đơn để lọc và phân trang.</p></section>
<c:if test="${legacy.total>0}"><div class="ex-notice">Có ${legacy.total} đơn cũ đã giao chưa có thời điểm giao. Chúng chưa được ghi nhận trong báo cáo mới; cần đối soát dữ liệu lịch sử.</div></c:if>
<p class="ex-muted">Doanh thu ghi nhận khi đơn đã giao và thu đủ tiền; hoàn tiền trừ vào ngày hoàn. Thời gian theo Việt Nam. Nạp ví và tiền gói dịch vụ được tách riêng.</p>
<c:forEach var="group" items="${['daily','monthly']}"><section class="ex-card"><h2>${group=='daily'?'Doanh thu từng ngày trong tháng đã chọn':'Doanh thu từng tháng trong năm'} <c:if test="${group=='monthly'}">${year}</c:if></h2><div class="ex-table"><table><thead><tr><th>${group=='daily'?'Ngày':'Tháng'}</th><th>Đơn ghi nhận</th><th>Doanh thu gộp</th><th>Hoàn tiền</th><th>Doanh thu thuần</th></tr></thead><tbody><c:forEach var="r" items="${group=='daily'?daily:monthly}"><tr><td><c:out value="${r.period}"/></td><td>${r.orders}</td><td><fmt:formatNumber value="${r.gross}" pattern="#,##0"/> đ</td><td><fmt:formatNumber value="${r.refunds}" pattern="#,##0"/> đ</td><td><strong><fmt:formatNumber value="${r.net}" pattern="#,##0"/> đ</strong></td></tr></c:forEach></tbody></table></div></section></c:forEach>
<section class="ex-card"><h2>Dòng tiền trong tháng đã chọn</h2><div class="ex-table"><table><thead><tr><th>Nguồn</th><th>Tiền vào</th><th>Tiền ra</th></tr></thead><tbody><c:forEach var="r" items="${cash}"><tr><td><c:out value="${r.source=='TOPUP'?'Nạp ví':r.source=='SERVICE'?'Gói dịch vụ':r.source=='RETURN'?'Hoàn tiền':r.source=='COD'?'Thu COD':'Chuyển khoản đơn hàng'}"/></td><td><fmt:formatNumber value="${r.incoming}" pattern="#,##0"/> đ</td><td><fmt:formatNumber value="${r.outgoing}" pattern="#,##0"/> đ</td></tr></c:forEach></tbody></table></div></section>
<%@ include file="footer.jspf" %>
