<%@ page pageEncoding="UTF-8" %>
<%@ include file="tags.jspf" %><c:set var="pageTitle" value="Đơn hàng & xác nhận thanh toán"/><%@ include file="header.jspf" %>
<form class="ex-card ex-filter" method="get"><label>Ngày có thể nhận<input type="date" name="day" value="${fn:escapeXml(day)}"></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><c:forEach var="s" items="${['PENDING','CONFIRMED','SHIPPING','DELIVERED','CANCELLED']}"><option value="${s}" ${status==s?'selected':''}><c:out value="${labels[s]}"/></option></c:forEach></select></label><button>Lọc đơn</button><a href="${cp}/admin/orders">Bỏ lọc</a></form>
<c:if test="${empty rows}"><div class="ex-card ex-empty">Chưa có đơn phù hợp.</div></c:if>
<c:forEach var="o" items="${rows}"><article class="ex-card"><div class="ex-row"><div><h2>Đơn #${o.order_id} · <c:out value="${o.username}"/></h2><span class="ex-badge"><c:out value="${labels[o.order_status]}"/></span> <span class="ex-badge"><c:out value="${labels[o.payment_status]}"/></span></div><strong class="ex-amount small"><fmt:formatNumber value="${o.total_amount}" pattern="#,##0"/> đ</strong></div>
<div class="ex-grid"><div><p><strong><c:out value="${o.recipient_name}"/></strong> · <c:out value="${o.recipient_phone}"/></p><p><c:out value="${o.shipping_address}"/></p><p>Ngày nhận: <c:out value="${empty o.desired_delivery_date?'Chưa có lịch':o.desired_delivery_date}"/> · <c:out value="${labels[o.delivery_slot]}"/></p><p>Ghi chú: <c:out value="${o.note}"/></p><a href="?detail=${o.order_id}">Xem sản phẩm trong đơn</a></div><div><p>Thanh toán: <c:out value="${labels[o.payment_method]}"/></p><p>Mã chuyển: <c:out value="${o.transfer_code}"/></p><c:if test="${not empty o.reported_at}"><p class="ex-notice">Khách đã báo chuyển: <c:out value="${o.reported_at_text}"/></p></c:if></div></div>
<c:choose><c:when test="${o.payment_count != 1}"><p class="ex-notice error">Đơn có ${o.payment_count} bản ghi thanh toán. Cần đối soát dữ liệu trước khi xử lý.</p></c:when><c:otherwise>
<c:if test="${permissions.contains('ORDER_REVIEW')}"><form class="ex-actions" method="post"><input type="hidden" name="id" value="${o.order_id}">
<c:if test="${o.order_status=='PENDING' && ((o.payment_method=='COD' && o.payment_status=='PENDING') || (o.payment_method=='BANK_TRANSFER' && o.payment_status=='PAID'))}"><button name="action" value="approve">Duyệt đơn</button></c:if>
<c:if test="${o.order_status=='CONFIRMED'}"><button name="action" value="ship">Bắt đầu giao hàng</button></c:if><c:if test="${o.order_status=='SHIPPING'}"><button name="action" value="deliver">Xác nhận đã giao</button></c:if>
<c:if test="${o.order_status=='PENDING' && (o.payment_status=='PENDING'||o.payment_status=='FAILED')}"><button class="danger" name="action" value="cancel">Hủy đơn chưa thanh toán</button></c:if><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"></form></c:if>
<c:if test="${permissions.contains('PAYMENT_REVIEW') && o.payment_status=='PENDING' && o.order_status!='CANCELLED'}">
<c:if test="${o.payment_method=='BANK_TRANSFER'}"><details><summary>Đối chiếu & xác nhận đã nhận chuyển khoản</summary><form class="ex-form" method="post"><input type="hidden" name="id" value="${o.order_id}"><input type="hidden" name="action" value="paid"><%@ include file="receipt.jspf" %><button>Xác nhận đã thu tiền</button><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"></form></details></c:if>
<c:if test="${o.payment_method=='COD' && (o.order_status=='SHIPPING'||o.order_status=='DELIVERED')}"><form class="ex-form" method="post"><input type="hidden" name="id" value="${o.order_id}"><input type="hidden" name="action" value="cod"><label>Tiền COD đã thu (VND)<input name="amount" type="number" min="1" step="1" required></label><button>Xác nhận đã thu COD</button><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"></form></c:if></c:if>
</c:otherwise></c:choose></article></c:forEach>
<c:if test="${not empty detailItems}"><section class="ex-card"><h2>Sản phẩm trong đơn #<c:out value="${param.detail}"/></h2><c:forEach var="i" items="${detailItems}"><p><c:out value="${i.product_name}"/> · <c:out value="${i.variant_sku}"/> × ${i.quantity} · <fmt:formatNumber value="${i.unit_price}" pattern="#,##0"/> đ/sản phẩm</p></c:forEach></section></c:if>
<%@ include file="paging.jspf" %><%@ include file="footer.jspf" %>
