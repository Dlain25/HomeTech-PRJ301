<%@ page pageEncoding="UTF-8" %>
<%@ include file="tags.jspf" %><c:set var="pageTitle" value="${adminMode?'Xử lý hoàn hàng':'Yêu cầu hoàn hàng của tôi'}"/><%@ include file="header.jspf" %>
<c:if test="${!adminMode}"><section class="ex-card"><h2>Gửi yêu cầu hoàn toàn bộ đơn</h2><p>Áp dụng cho đơn đã giao và đã thanh toán, trong 7 ngày kể từ ngày giao. Một yêu cầu/đơn; số tiền hoàn gồm phí giao hàng.</p><form class="ex-form" method="post"><label>Mã đơn hàng<input name="orderId" type="number" min="1" required value="${fn:escapeXml(param.orderId)}"></label><label>Lý do hoàn hàng<textarea name="reason" maxlength="1000" required></textarea></label><button>Gửi yêu cầu hoàn hàng</button><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"></form></section></c:if>
<c:if test="${empty rows}"><section class="ex-card ex-empty">Chưa có yêu cầu hoàn hàng.</section></c:if>
<c:forEach var="r" items="${rows}"><article class="ex-card"><div class="ex-row"><h2>Yêu cầu #${r.return_id} · Đơn #${r.order_id}</h2><span class="ex-badge"><c:out value="${labels[r.status]}"/></span></div><c:if test="${adminMode}"><p>Khách: <c:out value="${r.username}"/> · <c:out value="${r.recipient_name}"/></p></c:if><p>Lý do: <c:out value="${r.reason}"/></p><p>Tiền hoàn: <strong><fmt:formatNumber value="${r.refund_amount}" pattern="#,##0"/> đ</strong></p><p>Ngày yêu cầu: <c:out value="${r.created_at_text}"/></p><c:if test="${not empty r.review_note}"><p>Phản hồi: <c:out value="${r.review_note}"/></p></c:if><c:if test="${not empty r.received_at}"><p>Đã nhận hàng: <c:out value="${r.received_at_text}"/> · Nhập lại kho: ${r.restocked?'Có':'Không'}</p></c:if><c:if test="${not empty r.refunded_at}"><p>Đã hoàn tiền: <c:out value="${r.refunded_at_text}"/> · Mã <c:out value="${r.refund_reference}"/></p></c:if>
<c:if test="${adminMode}"><form class="ex-form" method="post"><input type="hidden" name="id" value="${r.return_id}">
<c:if test="${r.status=='REQUESTED'}"><label>Phản hồi (bắt buộc khi từ chối)<textarea name="note" maxlength="500"></textarea></label><div class="ex-actions"><button name="action" value="approve">Duyệt hoàn</button><button name="action" value="reject" class="danger">Từ chối</button></div></c:if>
<c:if test="${r.status=='APPROVED'}"><p>Chỉ xác nhận khi hàng đã được nhận và kiểm tra.</p><label class="ex-check"><input type="checkbox" name="restock" value="yes"> Toàn bộ hàng còn bán được, nhập lại kho</label><button name="action" value="receive">Đã nhận hàng hoàn</button></c:if>
<c:if test="${r.status=='RECEIVED'}"><label>Mã giao dịch hoàn tiền thực tế<input name="reference" maxlength="150" required></label><label class="ex-check"><input name="verified" type="checkbox" value="yes" required> Tôi đã hoàn đủ tiền cho khách</label><button name="action" value="refund">Xác nhận đã hoàn tiền</button></c:if><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"></form></c:if></article></c:forEach>
<%@ include file="paging.jspf" %><%@ include file="footer.jspf" %>
