<%@ page pageEncoding="UTF-8" %>
<%@ include file="tags.jspf" %><c:set var="pageTitle" value="${kind=='topup'?(adminMode?'Duyệt yêu cầu nạp ví':'Ví & nạp tiền'):(adminMode?'Gói dịch vụ & yêu cầu đăng ký':'Gói dịch vụ của tôi')}"/><%@ include file="header.jspf" %>
<c:if test="${!adminMode && !bankReady}"><div class="ex-notice">Cửa hàng chưa cấu hình chuyển khoản. Bạn vẫn xem được lịch sử; tạo yêu cầu trả tiền sẽ mở khi cấu hình sẵn sàng.</div></c:if>
<c:if test="${kind=='topup' && !adminMode}"><div class="ex-grid"><section class="ex-card ex-balance"><span>SỐ DƯ VÍ NỘI BỘ</span><h2 class="ex-amount"><fmt:formatNumber value="${balance}" pattern="#,##0"/> đ</h2><p>Nạp tiền được cộng sau khi admin xác nhận. Ví hiện hỗ trợ nạp và xem số dư, chưa dùng để thanh toán đơn hàng.</p></section><section class="ex-card"><h2>Tạo yêu cầu nạp</h2><form class="ex-form" method="post"><input type="hidden" name="requestKey" value="${requestKey}"><label>Số tiền nạp (VND)<input type="number" name="amount" min="10000" max="50000000" step="1" placeholder="100000" required></label><p class="ex-muted">Từ 10.000 đến 50.000.000đ/lần.</p><button ${!bankReady?'disabled':''}>Tiếp tục đến mã QR</button><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"></form></section></div></c:if>
<c:if test="${kind=='service'}"><h2>${adminMode?'Danh mục gói dịch vụ':'Chọn gói dịch vụ'}</h2><c:if test="${empty plans}"><div class="ex-card ex-empty">Chưa có gói dịch vụ đang mở.</div></c:if><div class="ex-grid"><c:forEach var="p" items="${plans}"><article class="ex-card"><h3><c:out value="${p.plan_name}"/></h3><p><c:out value="${p.description}"/></p><p class="ex-amount small"><fmt:formatNumber value="${p.price}" pattern="#,##0"/> đ</p><p>Thời hạn ${p.duration_days} ngày từ lúc duyệt. ${p.is_active?'Đang mở':'Đã ẩn'}</p>
<c:choose><c:when test="${!adminMode}"><form method="post"><input type="hidden" name="planId" value="${p.plan_id}"><input type="hidden" name="requestKey" value="${requestKey}"><button ${!bankReady?'disabled':''}>Đăng ký & xem QR</button><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"></form></c:when><c:otherwise><details><summary>Chỉnh sửa gói</summary><form class="ex-form" method="post"><input type="hidden" name="action" value="savePlan"><input type="hidden" name="planId" value="${p.plan_id}"><label>Tên gói<input name="planName" maxlength="120" required value="${fn:escapeXml(p.plan_name)}"></label><label>Mô tả<textarea name="description" maxlength="1000"><c:out value="${p.description}"/></textarea></label><label>Giá VND<input type="number" name="amount" min="1" step="1" required value="${p.price}"></label><label>Số ngày<input type="number" name="days" min="1" max="3650" required value="${p.duration_days}"></label><label class="ex-check"><input type="checkbox" name="active" value="yes" ${p.is_active?'checked':''}> Đang mở đăng ký</label><button>Lưu gói</button><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"></form></details></c:otherwise></c:choose></article></c:forEach></div>
<c:if test="${adminMode}"><details class="ex-card"><summary>+ Thêm gói dịch vụ</summary><form class="ex-form" method="post"><input type="hidden" name="action" value="savePlan"><label>Tên gói<input name="planName" maxlength="120" required></label><label>Mô tả<textarea name="description" maxlength="1000"></textarea></label><label>Giá VND<input name="amount" type="number" min="1" step="1" required></label><label>Thời hạn (ngày)<input name="days" type="number" min="1" max="3650" required></label><label class="ex-check"><input type="checkbox" name="active" value="yes" checked> Mở đăng ký</label><button>Tạo gói</button><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"></form></details></c:if><p class="ex-muted">Mỗi đăng ký có thời hạn độc lập, không cộng dồn khi đăng ký thêm cùng gói.</p></c:if>
<h2>${adminMode?'Danh sách yêu cầu':'Lịch sử yêu cầu'}</h2><c:if test="${empty rows}"><div class="ex-card ex-empty">Chưa có yêu cầu.</div></c:if>
<c:forEach var="r" items="${rows}"><article class="ex-card"><div class="ex-row"><h3>Yêu cầu #${r.target_id} <c:if test="${kind=='service'}">· <c:out value="${r.plan_name}"/></c:if></h3><span class="ex-badge"><c:out value="${kind=='service' && r.status=='ACTIVE' && r.ends_at le nowUtc?'Đã hết hạn':labels[r.status]}"/></span></div><p><c:if test="${adminMode}">Khách: <c:out value="${r.username}"/> · </c:if><strong><fmt:formatNumber value="${r.amount}" pattern="#,##0"/> đ</strong> · <c:out value="${r.created_at_text}"/></p><p>Nội dung chuyển: <c:out value="${r.transfer_code}"/></p><c:if test="${not empty r.reported_at}"><p class="ex-notice">Đã báo chuyển: <c:out value="${r.reported_at_text}"/></p></c:if><c:if test="${not empty r.review_note}"><p>Phản hồi: <c:out value="${r.review_note}"/></p></c:if><c:if test="${kind=='service' && r.status=='ACTIVE'}"><p>Hiệu lực: <c:out value="${r.starts_at_text}"/> → <c:out value="${r.ends_at_text}"/> (giờ Việt Nam)</p></c:if>
<c:if test="${r.status=='PENDING'}"><c:choose><c:when test="${!adminMode}"><a class="ex-button" href="${cp}/payment/qr?kind=${kind}&amp;id=${r.target_id}">Xem mã QR</a></c:when><c:otherwise><details><summary>Đối chiếu và xử lý yêu cầu</summary><form class="ex-form" method="post"><input type="hidden" name="id" value="${r.target_id}"><%@ include file="receipt.jspf" %><label>Ghi chú / lý do từ chối<textarea name="note" maxlength="500"></textarea></label><div class="ex-actions"><button name="action" value="approve">Đã nhận đủ tiền — duyệt</button><button class="danger" name="action" value="reject" formnovalidate>Từ chối yêu cầu</button></div><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"></form></details></c:otherwise></c:choose></c:if></article></c:forEach>
<%@ include file="paging.jspf" %><%@ include file="footer.jspf" %>
