<%@ page pageEncoding="UTF-8" %>
<article class="product-card ht-full-height">
    <a class="product-image" href="<c:url value='/product'><c:param name='id' value='${item.productId}'/></c:url>">
        <img src="<c:out value='${item.imageUrl}'/>" alt="<c:out value='${item.productName}'/>" loading="lazy" width="420" height="320" data-product-image>
        <c:if test="${item.featured}"><span class="product-badge">Nổi bật</span></c:if>
    </a>
    <div class="product-card-body">
        <span class="product-brand"><c:out value="${item.brandName}"/></span>
        <h3><a href="<c:url value='/product'><c:param name='id' value='${item.productId}'/></c:url>"><c:out value="${item.productName}"/></a></h3>
        <p class="product-category"><c:out value="${item.categoryName}"/></p>
        <div class="ht-push-bottom">
            <c:choose><c:when test="${not empty item.displayPrice}"><div class="price"><small>Từ </small><fmt:formatNumber value="${item.displayPrice}" maxFractionDigits="0"/> <span>₫</span></div></c:when>
            <c:otherwise><div class="unavailable-price">Chưa có phiên bản khả dụng</div></c:otherwise></c:choose>
            <a class="card-detail-link" href="<c:url value='/product'><c:param name='id' value='${item.productId}'/></c:url>">Xem chi tiết <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</article>

